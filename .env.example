# =============================================================================
# FLUXECS V2 — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local for local development.
# For Vercel deployment, configure these variables in Vercel Project Settings.

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# -----------------------------------------------------------------------------
# Required for production persistence of Events, Blogs, Resources, Site Copy,
# Council Rosters, Messages, and Subscribers.
# If omitted or offline, the application falls back safely to local JSON stores in data/.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/flux_ecs?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# 2. ADMINISTRATIVE ACCESS & AUTHENTICATION
# -----------------------------------------------------------------------------
# ADMIN_PASSWORD: Used for root Super Admin authentication.
ADMIN_PASSWORD=change_this_to_a_strong_password_for_secretariat_2026

# ADMIN_SECRET: Secret key used to sign HMAC session tokens. Minimum 32 hex characters.
ADMIN_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# 3. CLOUD MEDIA STORAGE (Supabase Storage / Vercel-compatible)
# -----------------------------------------------------------------------------
# Required on Vercel serverless to persist uploaded event posters, portraits & PDFs.
# If not configured, uploads fall back to local disk (/public/posters/uploads/).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=media

# -----------------------------------------------------------------------------
# 4. DEPLOYMENT & STREAM METADATA
# -----------------------------------------------------------------------------
# Public canonical URL of the deployed application
NEXT_PUBLIC_SITE_URL=https://aarya-fluxecs.vercel.app

# Optional custom stream or royalty-free audio URL for PitRadio
# Defaults to /media/ambient-pit.wav if not specified
NEXT_PUBLIC_RADIO_URL=/media/ambient-pit.wav
