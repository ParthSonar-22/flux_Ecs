# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# scratch / temp
/scratch/
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# User-selected footage for local review. Rights not yet cleared for distribution.
/public/media/local-preview/

# Local CMS database, private uploads and local-only notification output
/.data/
*.db-wal
*.db-shm
